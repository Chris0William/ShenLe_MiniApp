}
.form-group.data-v-defbd82e {
  margin-bottom: 24rpx;
}
.form-label.data-v-defbd82e {
  display: block;
  font-size: 24rpx;
  color: #64748B;
  margin-bottom: 8rpx;
}
.form-input.data-v-defbd82e {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background-color: #F8FAFC;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #1E293B;
  box-sizing: border-box;
}
.form-actions.data-v-defbd82e {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}
.form-btn.data-v-defbd82e {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
