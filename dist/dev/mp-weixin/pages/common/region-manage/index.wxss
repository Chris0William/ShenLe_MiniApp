.page.data-v-defbd82e {
  min-height: 100vh;
  background-color: #F8FAFC;
  display: flex;
  flex-direction: column;
}
.page-header.data-v-defbd82e {
  padding: 24rpx 32rpx;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #E2E8F0;
}
.page-title.data-v-defbd82e {
  font-size: 36rpx;
  font-weight: 700;
  color: #1E293B;
}
.map-section.data-v-defbd82e {
  position: relative;
  background-color: #FFFFFF;
}
.region-map.data-v-defbd82e {
  width: 100%;
  height: 400rpx;
}
.region-map.expanded.data-v-defbd82e {
  height: calc(100vh - 200rpx);
}
.edit-bar.data-v-defbd82e {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  background-color: rgba(239, 68, 68, 0.95);
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.edit-info.data-v-defbd82e {
  flex: 1;
  min-width: 0;
}
.edit-hint.data-v-defbd82e {
  font-size: 24rpx;
  color: #fff;
  display: block;
}
.edit-count.data-v-defbd82e {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}
.edit-actions.data-v-defbd82e {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}
.edit-btn.data-v-defbd82e {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  color: #fff;
  background-color: rgba(255, 255, 255, 0.2);
}
.edit-btn.cancel.data-v-defbd82e {
  background-color: rgba(255, 255, 255, 0.15);
}
.edit-btn.save.data-v-defbd82e {
  background-color: #fff;
  color: #EF4444;
  font-weight: 600;
}
.panel-handle.data-v-defbd82e {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 12rpx 0;
  background-color: #FFFFFF;
  border-top: 1rpx solid #E2E8F0;
  border-bottom: 1rpx solid #E2E8F0;
}
.handle-bar.data-v-defbd82e {
  width: 60rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background-color: #E2E8F0;
}
.handle-arrow.data-v-defbd82e {
  font-size: 18rpx;
  color: #94A3B8;
}
.handle-text.data-v-defbd82e {
  font-size: 22rpx;
  color: #94A3B8;
}
.list-area.data-v-defbd82e {
  flex: 1;
  padding: 16rpx;
  padding-bottom: 200rpx;
}
.empty-wrap.data-v-defbd82e {
  padding: 48rpx;
  text-align: center;
}
.empty-text.data-v-defbd82e {
  color: #64748B;
  font-size: 24rpx;
}
.tree-l1.data-v-defbd82e {
  margin-bottom: 16rpx;
}
.tree-item.data-v-defbd82e {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  transition: background-color 0.2s;
}
.tree-item.sub.data-v-defbd82e {
  margin-left: 32rpx;
  margin-top: 8rpx;
  background-color: rgba(255, 255, 255, 0.8);
}
.tree-item.located.data-v-defbd82e {
  background-color: rgba(245, 158, 11, 0.08);
  box-shadow: inset 0 0 0 1rpx rgba(245, 158, 11, 0.3);
}
.item-left.data-v-defbd82e {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
  flex: 1;
}
.expand-arrow.data-v-defbd82e {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: transform 0.2s;
}
.expand-arrow.expanded.data-v-defbd82e {
  transform: rotate(90deg);
}
.arrow-icon.data-v-defbd82e {
  font-size: 20rpx;
  color: #64748B;
}
.item-name.data-v-defbd82e {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E293B;
}
.boundary-badge.data-v-defbd82e {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  background-color: rgba(59, 130, 246, 0.1);
  color: #3B82F6;
  flex-shrink: 0;
}
.boundary-badge.green.data-v-defbd82e {
  background-color: rgba(16, 185, 129, 0.1);
  color: #10B981;
}
.item-actions.data-v-defbd82e {
  display: flex;
  gap: 8rpx;
  flex-shrink: 0;
}
.act-btn.data-v-defbd82e {
  font-size: 20rpx;
  padding: 8rpx 16rpx;
  border-radius: 6rpx;
}
.act-btn.add.data-v-defbd82e {
  color: #3B82F6;
  background-color: rgba(24, 144, 255, 0.1);
}
.act-btn.boundary.data-v-defbd82e {
  color: #8B5CF6;
  background-color: rgba(139, 92, 246, 0.1);
}
.act-btn.boundary.done.data-v-defbd82e {
  color: #fff;
  background-color: #8B5CF6;
}
.act-btn.edit.data-v-defbd82e {
  color: #faad14;
  background-color: rgba(250, 173, 20, 0.1);
}
.act-btn.del.data-v-defbd82e {
  color: #EF4444;
  background-color: rgba(255, 77, 79, 0.1);
}
.tree-children.data-v-defbd82e {
  padding-bottom: 8rpx;
}
.fab.data-v-defbd82e {
  position: fixed;
  right: 32rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background-color: #3B82F6;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.4);
}
.fab-icon.data-v-defbd82e {
  font-size: 48rpx;
  color: #ffffff;
  font-weight: 300;
}
.modal-mask.data-v-defbd82e {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.modal-panel.data-v-defbd82e {
  width: 85%;
  background-color: #FFFFFF;
  border-radius: 16rpx;
