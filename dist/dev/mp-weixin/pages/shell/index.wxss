.shell.data-v-ad88add4 {
  min-height: 100vh;
  background-color: #F8FAFC;
}

/* ─── 登录弹窗 ─── */
.login-overlay.data-v-ad88add4 {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}
.login-modal.data-v-ad88add4 {
  width: 600rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 60rpx 48rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}
.login-logo.data-v-ad88add4 {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  background-color: #3B82F6;
  display: flex;
  align-items: center;
  justify-content: center;
}
.login-logo-text.data-v-ad88add4 {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 700;
}
.login-title.data-v-ad88add4 {
  font-size: 32rpx;
  color: #1E293B;
  font-weight: 600;
}
.login-wx-btn.data-v-ad88add4 {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #07c160;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}
.login-wx-btn[disabled].data-v-ad88add4 {
  opacity: 0.6;
}
.login-wx-icon.data-v-ad88add4 {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}
.login-tip.data-v-ad88add4 {
  font-size: 20rpx;
  color: #94A3B8;
  text-align: center;
}
.login-subtitle.data-v-ad88add4 {
  font-size: 24rpx;
  color: #64748B;
}
.avatar-chooser.data-v-ad88add4 {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  padding: 0;
  margin: 0;
  background-color: transparent;
  border: none;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-chooser.data-v-ad88add4::after {
  border: none;
}
.avatar-preview.data-v-ad88add4 {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
}
.avatar-placeholder.data-v-ad88add4 {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: #F8FAFC;
  border: 2rpx dashed #E2E8F0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.avatar-placeholder-icon.data-v-ad88add4 {
  font-size: 48rpx;
  color: #94A3B8;
  line-height: 1;
}
.avatar-placeholder-text.data-v-ad88add4 {
  font-size: 20rpx;
  color: #94A3B8;
}
.nickname-input.data-v-ad88add4 {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #E2E8F0;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1E293B;
  box-sizing: border-box;
}