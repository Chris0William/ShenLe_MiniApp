}
.modal-title.data-v-defbd82e {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 24rpx;
  text-align: center;
}
.form-group.data-v-defbd82e {
  margin-bottom: 24rpx;
}
.form-label.data-v-defbd82e {
  display: block;
  font-size: 24rpx;
  color: #6B7280;
