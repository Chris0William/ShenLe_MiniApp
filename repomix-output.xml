              mode="aspectFill"
            />
            <view v-if="isVideo(item.coverImage)" class="play-badge">
              <text class="play-icon">&#x25B6;</text>
            </view>
            <view class="status-badge" :class="'s' + item.status">
              <text>{{ item.statusName }}</text>
            </view>
          </view>
          <view class="card-right">
            <text class="card-title">{{ item.title }}</text>
            <text class="card-desc">{{ item.houseType }} | {{ item.area ?? '-' }}m²</text>
            <text class="card-location">{{ item.communityName }}{{ item.floorInfo ? ' · ' + item.floorInfo : '' }}</text>
            <view class="card-bottom">
              <text class="card-price">¥{{ item.rentPrice }}<text class="price-unit">/月</text></text>
              <view class="card-actions">
                <view class="act-btn edit" @tap.stop="onEdit(item.id)">
