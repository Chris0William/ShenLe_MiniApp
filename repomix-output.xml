<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'
import { useAppStore } from '@/stores/app'
import {
  getPropertyPage,
  getPropertyGlobalStats,
  deleteProperty,
  updatePropertyStatus,
} from '@/api/property'
import type { SlPropertyListOutput, SlPropertyGlobalStatsOutput, PropertyFilterState } from '@/types/property'

const appStore = useAppStore()

// ---- Stats ----
const globalStats = ref<SlPropertyGlobalStatsOutput | null>(null)

async function loadStats() {
  try {
    globalStats.value = await getPropertyGlobalStats()
  } catch {}
}

function getTabCount(value: number | undefined): string {
  if (!globalStats.value) return ''
  if (value === undefined) return `${globalStats.value.totalCount}`
  const map: Record<number, number> = {
    0: globalStats.value.vacantCount,
    1: globalStats.value.reservedCount,
    2: globalStats.value.rentedCount,
    3: globalStats.value.offlineCount,
  }
  return `${map[value] ?? 0}`
}

// ---- Filter state ----
const statusTabs = [
  { label: '全部', value: undefined as number | undefined },
  { label: '空置', value: 0 },
  { label: '预定', value: 1 },
  { label: '已租', value: 2 },
  { label: '下架', value: 3 },
]
const activeStatus = ref<number | undefined>(undefined)
const keyword = ref('')

// ---- Filter panel ----
const showFilter = ref(false)
const filterState = ref<PropertyFilterState>({})

function toggleFilter() {
  showFilter.value = !showFilter.value
}

function onFilterConfirm(filters: PropertyFilterState) {
  filterState.value = filters
  showFilter.value = false
  loadData(true)
}

function onFilterReset() {
  filterState.value = {}
  showFilter.value = false
  loadData(true)
}

const filterCount = computed(() => {
  let count = 0
  const f = filterState.value
  if (f.regionId) count++
  if (f.bedrooms) count++
  if (f.minPrice !== undefined || f.maxPrice !== undefined) count++
  if (f.orientation) count++
  if (f.decoration) count++
  if (f.rentalType) count++
  if (f.minArea !== undefined || f.maxArea !== undefined) count++
  if (f.communityId) count++
  if (f.depositRule) count++
  return count
})

// ---- Pagination ----
const page = ref(1)
const pageSize = 10
const list = ref<SlPropertyListOutput[]>([])
const loadStatus = ref<'more' | 'loading' | 'noMore'>('more')

async function loadData(reset = false) {
  if (reset) {
    page.value = 1
    list.value = []
  }
  if (loadStatus.value === 'loading') return
  loadStatus.value = 'loading'
  try {
    const res = await getPropertyPage({
      page: page.value,
      pageSize,
      status: activeStatus.value,
      title: keyword.value || undefined,
      ...filterState.value,
    })
    list.value = reset ? res.items : [...list.value, ...res.items]
    loadStatus.value = res.items.length < pageSize ? 'noMore' : 'more'
    page.value++
  } catch {
    loadStatus.value = 'more'
  }
}

function onTabChange(value: number | undefined) {
  activeStatus.value = value
  loadData(true)
}

function onSearch() {
  loadData(true)
}

function onLoadMore() {
  if (loadStatus.value === 'more') loadData()
}

function onRefresh() {
  loadStats()
  loadData(true)
}

// ---- Actions ----
function onCardTap(id: number) {
  uni.navigateTo({ url: `/pages/common/property-detail/index?id=${id}` })
}

function onEdit(id: number) {
  uni.navigateTo({ url: `/pages/common/property-form/index?id=${id}` })
}

function onDelete(id: number) {
  uni.showModal({
    title: '确认删除',
    content: '删除后不可恢复，确定删除？',
    success: async (res) => {
      if (res.confirm) {
        try {
          await deleteProperty({ id: String(id) })
          uni.showToast({ title: '删除成功', icon: 'success' })
          loadStats()
          loadData(true)
        } catch {}
      }
    },
  })
}

// ---- Status change ----
const showStatusModal = ref(false)
const statusTargetId = ref(0)
const statusOptions = [
  { label: '空置', value: 0, color: '#22C55E' },
  { label: '预定', value: 1, color: '#F97316' },
  { label: '已租', value: 2, color: '#9CA3AF' },
  { label: '下架', value: 3, color: '#EF4444' },
]

function onChangeStatus(id: number) {
  statusTargetId.value = id
  showStatusModal.value = true
}

async function confirmStatusChange(status: number) {
  showStatusModal.value = false
  try {
    await updatePropertyStatus({ id: statusTargetId.value, status })
    uni.showToast({ title: '状态已更新', icon: 'success' })
    loadStats()
    loadData(true)
  } catch {}
}

function goAddProperty() {
  uni.navigateTo({ url: '/pages/common/property-form/index' })
}

// ---- Video detection ----
const VIDEO_EXTS = ['.mp4', '.mov', '.avi', '.wmv', '.flv', '.mkv']

function isVideo(url?: string): boolean {
  if (!url) return false
  const lower = url.toLowerCase().split('?')[0]
  return VIDEO_EXTS.some(ext => lower.endsWith(ext))
}

function getCoverSrc(url?: string): string {
  if (!url || isVideo(url)) return '/static/images/placeholder.png'
  return url
}

onMounted(() => {
  loadStats()
  loadData(true)
})
</script>

